# ai-sudo daemon configuration.
#
# This file is also the daemon's bootstrap default: if aisudo-daemon starts
# and finds no config file at the given path, it installs this exact content
# there and continues (never overwriting or merging into an existing file).
# EVERY value below is commented out — this file has no active settings at
# all. Every field the daemon reads is serde-defaulted, so a fully-commented
# file is valid and the daemon simply runs on its compiled-in defaults (shown
# inline, commented, for discoverability). In particular no approval backend
# is configured (see the commented [askgw]/[askgw_http]/[telegram] sections
# further down): the daemon still starts, but warns loudly at startup and on
# every request that would need one, and denies any such request outright —
# only allowlisted commands auto-approve. Uncomment and edit values here, or
# (preferred) add real settings via conf.d/*.toml, to change any of this.
#
# Real, host-specific configuration belongs in conf.d/*.toml next to this
# file (e.g. /etc/aisudo/conf.d/99-local.toml), which ai-sudo deep-merges
# over this file, merged alphabetically: scalar values are replaced;
# allowlist entries are appended and deduplicated. Prefer a drop-in over
# editing this file directly — if something else (packaging, config
# management) owns this file's provenance, direct edits here can be
# clobbered or lost on the next rebuild/reseed.

# Path to the Unix socket for PAM module communication
# socket_path = "/var/run/aisudo/aisudo.sock"

# Path to the SQLite database
# db_path = "/var/lib/aisudo/aisudo.db"

# Default timeout for approval requests (seconds)
# timeout_seconds = 60

# Hot-reload config on each incoming connection (checks file modification times).
# Only per-connection values are reloaded: allowlist, timeout_seconds, max_stdin_bytes.
# Structural values (socket_path, db_path) and notification settings
# are set at startup and require a restart.
# hot_reload = false

# Commands that are auto-approved without notification.
# Matching is prefix-based at a whitespace boundary: an entry matches the command
# exactly, or the command with more arguments after a space. "apt list" matches
# "apt list --installed" but NOT "apt listsomething". It does NOT match sub-paths:
# "cat /etc" does NOT allow "cat /etc/shadow" — list the exact commands you mean.
#
# SECURITY: only list commands that CANNOT execute arbitrary code or write
# arbitrary files as root. Do NOT auto-approve things like `apt install`
# (runs package maintainer scripts / local .deb as root) — route those
# through Telegram approval instead.
# allowlist = [
#     "systemctl status",
#     "apt list",
# ]

# Commands always denied, even if allowlisted or covered by a temp rule.
# Checked first - deny always takes precedence. Same prefix-matching rules
# as allowlist.
# denylist = ["mkfs", "rm -rf /"]

# Per-user allowlists, additive to the global allowlist above. Keys are
# usernames, values are lists of command patterns (same matching rules).
# [allowlist_per_user]
# alice = ["docker ps", "kubectl get"]

# --- macOS allowlist (uncomment on Darwin) ---------------------------
# These are read-only commands safe to auto-approve on macOS. Linux users:
# leave this commented; the defaults above and the project README are
# Linux-shaped. Note `/var/lib/aisudo/aisudo.db` doesn't exist on macOS —
# the daemon uses `/var/db/aisudo/aisudo.db` there automatically, so the
# db_path below stays commented.
#
# allowlist = [
#     "brew list",
#     "brew search",
#     "brew info",
#     "launchctl list",
#     "log show",
#     "diskutil list",
#     "softwareupdate --list",
#     "ps aux",
#     "vm_stat",
#     "networksetup -listallhardwareports",
# ]

# Stdin size limits and temp rule settings
# [limits]
# Maximum stdin payload size in bytes (default: 10 MB)
# max_stdin_bytes = 10485760
# Stdin preview size in Telegram notifications (default: 2048 bytes)
# stdin_preview_bytes = 2048
# Maximum duration for temporary rules (default: 86400 = 24 hours)
# max_temp_rule_duration_seconds = 86400
# Delete request/audit/history records older than this many days. The daemon
# prunes hourly and reclaims disk automatically (auto_vacuum). 0 = keep forever.
# (default: 365)
# history_retention_days = 365

# Approval backend. Configure ONE of [askgw], [askgw_http], or [telegram].
# If more than one is set, precedence is [askgw] > [askgw_http] > [telegram].
# If none is set, the daemon still starts (it warns loudly, at startup and on
# every request that would need approval) but denies any such request — only
# allowlisted commands are auto-approved without one of these configured.

# ask-gateway backend: routes approval prompts through foci's interactive button
# surface over a local Unix socket instead of Telegram.
# [askgw]
# Path to the askgw socket (typically foci's data dir / askgw.sock).
# NOTE: bare /run does not exist on macOS — use /var/run/... there.
# socket_path = "/run/foci/askgw.sock"
#
# Expected owner of the socket, as a username ("foci") or numeric uid ("994").
# Before connecting, the backend stats the socket and refuses to proceed if the
# owner doesn't match. An unknown username is a fatal startup error (fail closed).
# gateway_uid = "foci"
#
# Optional agent name to route asks to. If unset, the gateway uses its default.
# agent = "clutch"

# ask-gateway over HTTP: same approval flow as [askgw], but reaches foci's
# network-facing askgw endpoint instead of a Unix socket. For a REMOTE host
# (e.g. a Mac running aisudo) that can't reach foci's local socket without
# ssh-forwarding it. Requires foci's [askgw] http_enabled = true (foci-side
# todo #1463 — the exact wire shape may still be settling; see
# notification::askgw_http module doc in this repo for what this backend
# currently assumes). Also POSTs Bitwarden-unlock/access-link/scrub-complete/
# command-completion notifications to foci's HTTP notify endpoint (foci-side
# todo #1466, also assumed pending that landing — see the module doc).
# [askgw_http]
# Base URL of foci's HTTP server. No trailing slash.
# endpoint = "https://foci.example.ts.net"
#
# SAME value as foci's `http.api_key` secret. Sent as a bearer token.
# api_key = "your-foci-http-api-key"
#
# Optional agent name to route asks to. If unset, the gateway uses its default.
# agent = "clutch"
#
# Long-poll GET wait, in seconds (foci's server-side max is assumed to clamp
# this further regardless).
# poll_wait_seconds = 20
#
# HTTP client timeout per request (submit/poll/cancel), in seconds. Should
# exceed poll_wait_seconds by a margin.
# request_timeout_seconds = 30

# Telegram backend: the original approval channel, and the simplest to set
# up for a single standalone host (no foci install needed).
# [telegram]
# Create a bot via @BotFather on Telegram and paste the token here.
# bot_token = "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
#
# Your Telegram chat ID. Send /start to @userinfobot to find yours.
# chat_id = 123456789
#
# Long-poll timeout for Telegram getUpdates (seconds)
# poll_timeout_seconds = 30

# Optional Bitwarden integration + web unlock UI.
# [bitwarden]
# session_log_dir = "/home/youruser/.aibw/sessions"
#
# The web UI is gated by a single-use access code delivered over Telegram.
# Set this to the UI's public https URL (e.g. behind `tailscale serve`) so the
# daemon can send tappable unlock links. If unset, link delivery is disabled.
# web_external_url = "https://your-host.your-tailnet.ts.net"
#
# web_ui_port = 8377                  # localhost port the UI binds to
# code_ttl_seconds = 600              # lifetime of an access code (default 10 min)
# session_ttl_seconds = 900           # web session lifetime after redeeming a code
# code_request_cooldown_seconds = 30  # min interval between "send access code" requests
# max_password_attempts = 5           # master-password attempts per session window
